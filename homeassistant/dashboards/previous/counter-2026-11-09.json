{
 "title": "Counter",
 "views": [
  {
   "title": "Home",
   "path": "home",
   "icon": "mdi:home-variant",
   "type": "sections",
   "max_columns": 3,
   "dense_section_placement": true,
   "badges": [
    {
     "type": "entity",
     "entity": "weather.kgcc_daynight",
     "show_name": false,
     "show_state": true,
     "show_icon": true
    },
    {
     "type": "entity",
     "entity": "lock.touchscreen_deadbolt_z_wave_plus",
     "name": "Back Porch",
     "show_name": true
    },
    {
     "type": "entity",
     "entity": "switch.front_porch",
     "name": "Porch Lights",
     "show_name": true,
     "tap_action": {
      "action": "toggle"
     }
    },
    {
     "type": "entity",
     "entity": "sensor.hot_tub_current_temperature",
     "name": "Hot Tub",
     "show_name": true,
     "icon": "mdi:hot-tub",
     "tap_action": {
      "action": "navigate",
      "navigation_path": "/dashboard-counter/hot-tub"
     }
    }
   ],
   "sections": [
    {
     "type": "grid",
     "column_span": 3,
     "cards": [
      {
       "type": "custom:mushroom-template-card",
       "primary": "{{ now().strftime('%-I:%M %p') }}",
       "secondary": "{{ now().strftime('%A, %B %-d') }} \u00b7 {{ state_attr('weather.kgcc_daynight','temperature') | round(0) }}\u00b0F outside",
       "icon": "{% set w = states('weather.kgcc_daynight') %}{{ {'clear-night':'mdi:weather-night','sunny':'mdi:weather-sunny','partlycloudy':'mdi:weather-partly-cloudy','cloudy':'mdi:weather-cloudy','rainy':'mdi:weather-rainy','snowy':'mdi:weather-snowy','snowy-rainy':'mdi:weather-snowy-rainy','windy':'mdi:weather-windy','fog':'mdi:weather-fog','lightning':'mdi:weather-lightning','pouring':'mdi:weather-pouring'}.get(w,'mdi:weather-partly-cloudy') }}",
       "icon_color": "blue",
       "entity": "weather.kgcc_daynight",
       "tap_action": {
        "action": "more-info"
       },
       "grid_options": {
        "columns": 12
       }
      }
     ]
    },
    {
     "type": "grid",
     "column_span": 2,
     "cards": [
      {
       "type": "heading",
       "heading": "Gate & Garage",
       "icon": "mdi:shield-home-outline",
       "heading_style": "title"
      },
      {
       "type": "custom:mushroom-template-card",
       "entity": "cover.gate_switch_gate",
       "primary": "Gate",
       "secondary": "{{ 'Open \u00b7 tap to close' if is_state('cover.gate_switch_gate','open') else 'Closed \u00b7 tap to open' }}",
       "icon": "{{ 'mdi:gate-open' if is_state('cover.gate_switch_gate','open') else 'mdi:gate' }}",
       "icon_color": "{{ 'amber' if is_state('cover.gate_switch_gate','open') else 'green' }}",
       "layout": "vertical",
       "fill_container": true,
       "tap_action": {
        "action": "perform-action",
        "perform_action": "cover.toggle",
        "target": {
         "entity_id": "cover.gate_switch_gate"
        },
        "confirmation": {
         "text": "Open/close the gate?"
        }
       },
       "hold_action": {
        "action": "more-info"
       },
       "grid_options": {
        "columns": 4,
        "rows": 3
       }
      },
      {
       "type": "custom:mushroom-template-card",
       "entity": "binary_sensor.garage_door_sensor_single_home_security_intrusion",
       "primary": "Single Garage",
       "secondary": "{{ 'Open \u00b7 tap to close' if is_state('binary_sensor.garage_door_sensor_single_home_security_intrusion','on') else 'Closed \u00b7 tap to open' }}",
       "icon": "{{ 'mdi:garage-open-variant' if is_state('binary_sensor.garage_door_sensor_single_home_security_intrusion','on') else 'mdi:garage-variant' }}",
       "icon_color": "{{ 'amber' if is_state('binary_sensor.garage_door_sensor_single_home_security_intrusion','on') else 'green' }}",
       "layout": "vertical",
       "fill_container": true,
       "tap_action": {
        "action": "perform-action",
        "perform_action": "switch.toggle",
        "target": {
         "entity_id": "switch.garage_opener_single"
        },
        "confirmation": {
         "text": "Open/close the single garage door?"
        }
       },
       "hold_action": {
        "action": "more-info"
       },
       "grid_options": {
        "columns": 4,
        "rows": 3
       }
      },
      {
       "type": "custom:mushroom-template-card",
       "entity": "binary_sensor.garage_door_sensor_double_home_security_intrusion",
       "primary": "Double Garage",
       "secondary": "{{ 'Open \u00b7 tap to close' if is_state('binary_sensor.garage_door_sensor_double_home_security_intrusion','on') else 'Closed \u00b7 tap to open' }}",
       "icon": "{{ 'mdi:garage-open-variant' if is_state('binary_sensor.garage_door_sensor_double_home_security_intrusion','on') else 'mdi:garage-variant' }}",
       "icon_color": "{{ 'amber' if is_state('binary_sensor.garage_door_sensor_double_home_security_intrusion','on') else 'green' }}",
       "layout": "vertical",
       "fill_container": true,
       "tap_action": {
        "action": "perform-action",
        "perform_action": "switch.toggle",
        "target": {
         "entity_id": "switch.garage_opener_double"
        },
        "confirmation": {
         "text": "Open/close the double garage door?"
        }
       },
       "hold_action": {
        "action": "more-info"
       },
       "grid_options": {
        "columns": 4,
        "rows": 3
       }
      },
      {
       "type": "picture-entity",
       "entity": "camera.gate_keypad_live_view",
       "camera_view": "auto",
       "show_name": false,
       "show_state": false,
       "grid_options": {
        "columns": 12
       }
      }
     ]
    },
    {
     "type": "grid",
     "column_span": 1,
     "cards": [
      {
       "type": "heading",
       "heading": "Climate",
       "icon": "mdi:home-thermometer-outline",
       "heading_style": "title"
      },
      {
       "type": "thermostat",
       "entity": "climate.main",
       "name": "House",
       "features": [
        {
         "type": "climate-hvac-modes",
         "hvac_modes": [
          "heat",
          "auto",
          "off"
         ]
        }
       ],
       "grid_options": {
        "columns": 12
       }
      },
      {
       "type": "tile",
       "entity": "sensor.main_thermostat_humidity_2",
       "name": "Humidity",
       "grid_options": {
        "columns": 6,
        "rows": 2
       }
      },
      {
       "type": "tile",
       "entity": "sensor.main_outdoor_temperature_2",
       "name": "Outside",
       "grid_options": {
        "columns": 6,
        "rows": 2
       }
      },
      {
       "type": "custom:mushroom-template-card",
       "primary": "Hot Tub",
       "secondary": "{{ states('sensor.hot_tub_current_temperature') | round(0) }}\u00b0F \u00b7 set {{ state_attr('climate.hot_tub_temperature','temperature') | round(0) }}\u00b0F",
       "icon": "mdi:hot-tub",
       "icon_color": "deep-orange",
       "fill_container": true,
       "tap_action": {
        "action": "navigate",
        "navigation_path": "/dashboard-counter/hot-tub"
       },
       "grid_options": {
        "columns": 12
       }
      }
     ]
    }
   ]
  },
  {
   "title": "Hot Tub",
   "path": "hot-tub",
   "icon": "mdi:hot-tub",
   "type": "sections",
   "max_columns": 3,
   "dense_section_placement": true,
   "badges": [
    {
     "type": "entity",
     "entity": "sensor.hot_tub_current_temperature",
     "name": "Water",
     "show_name": true
    },
    {
     "type": "entity",
     "entity": "sensor.hot_tub_heater_power",
     "name": "Heater",
     "show_name": true
    },
    {
     "type": "entity",
     "entity": "sensor.hot_tub_salt_content",
     "name": "Salt",
     "show_name": true
    },
    {
     "type": "entity",
     "entity": "sensor.hot_tub_logo_lights",
     "name": "Status",
     "show_name": true
    }
   ],
   "sections": [
    {
     "type": "grid",
     "column_span": 1,
     "cards": [
      {
       "type": "heading",
       "heading": "Temperature",
       "icon": "mdi:thermometer-water",
       "heading_style": "title"
      },
      {
       "type": "thermostat",
       "entity": "climate.hot_tub_temperature",
       "name": "Hot Tub",
       "grid_options": {
        "columns": 12
       }
      },
      {
       "type": "custom:mushroom-template-card",
       "primary": "Back to Home",
       "secondary": "Gate, garage & thermostat",
       "icon": "mdi:arrow-left",
       "icon_color": "grey",
       "fill_container": true,
       "tap_action": {
        "action": "navigate",
        "navigation_path": "/dashboard-counter/home"
       },
       "grid_options": {
        "columns": 12
       }
      }
     ]
    },
    {
     "type": "grid",
     "column_span": 2,
     "cards": [
      {
       "type": "heading",
       "heading": "Controls",
       "icon": "mdi:hot-tub",
       "heading_style": "title"
      },
      {
       "type": "custom:mushroom-entity-card",
       "entity": "fan.hot_tub_jets_1",
       "name": "Jets 1",
       "icon": "mdi:turbine",
       "icon_color": "cyan",
       "layout": "vertical",
       "fill_container": true,
       "tap_action": {
        "action": "toggle"
       },
       "grid_options": {
        "columns": 4,
        "rows": 2
       }
      },
      {
       "type": "custom:mushroom-entity-card",
       "entity": "fan.hot_tub_jets_2",
       "name": "Jets 2",
       "icon": "mdi:turbine",
       "icon_color": "cyan",
       "layout": "vertical",
       "fill_container": true,
       "tap_action": {
        "action": "toggle"
       },
       "grid_options": {
        "columns": 4,
        "rows": 2
       }
      },
      {
       "type": "custom:mushroom-entity-card",
       "entity": "switch.hot_tub_lights",
       "name": "Lights",
       "icon": "mdi:lightbulb-on",
       "icon_color": "amber",
       "layout": "vertical",
       "fill_container": true,
       "tap_action": {
        "action": "toggle"
       },
       "grid_options": {
        "columns": 4,
        "rows": 2
       }
      },
      {
       "type": "custom:mushroom-entity-card",
       "entity": "switch.hot_tub_clean_cycle",
       "name": "Clean Cycle",
       "icon": "mdi:broom",
       "icon_color": "teal",
       "layout": "vertical",
       "fill_container": true,
       "tap_action": {
        "action": "toggle"
       },
       "grid_options": {
        "columns": 4,
        "rows": 2
       }
      },
      {
       "type": "custom:mushroom-entity-card",
       "entity": "switch.hot_tub_salt_boost",
       "name": "Salt Boost",
       "icon": "mdi:shaker",
       "icon_color": "light-blue",
       "layout": "vertical",
       "fill_container": true,
       "tap_action": {
        "action": "toggle"
       },
       "grid_options": {
        "columns": 4,
        "rows": 2
       }
      },
      {
       "type": "custom:mushroom-entity-card",
       "entity": "switch.hot_tub_spa_lock",
       "name": "Spa Lock",
       "icon": "mdi:lock",
       "icon_color": "red",
       "layout": "vertical",
       "fill_container": true,
       "tap_action": {
        "action": "toggle"
       },
       "grid_options": {
        "columns": 4,
        "rows": 2
       }
      },
      {
       "type": "heading",
       "heading": "Lighting",
       "icon": "mdi:palette",
       "heading_style": "title"
      },
      {
       "type": "tile",
       "entity": "select.hot_tub_color_underwater",
       "name": "Underwater",
       "grid_options": {
        "columns": 6,
        "rows": 2
       },
       "features": [
        {
         "type": "select-options"
        }
       ]
      },
      {
       "type": "tile",
       "entity": "select.hot_tub_color_exterior",
       "name": "Exterior",
       "grid_options": {
        "columns": 6,
        "rows": 2
       },
       "features": [
        {
         "type": "select-options"
        }
       ]
      },
      {
       "type": "tile",
       "entity": "select.hot_tub_color_bartop",
       "name": "Bartop",
       "grid_options": {
        "columns": 6,
        "rows": 2
       },
       "features": [
        {
         "type": "select-options"
        }
       ]
      },
      {
       "type": "tile",
       "entity": "select.hot_tub_color_pillow",
       "name": "Pillow",
       "grid_options": {
        "columns": 6,
        "rows": 2
       },
       "features": [
        {
         "type": "select-options"
        }
       ]
      },
      {
       "type": "tile",
       "entity": "select.hot_tub_color_cycle_speed",
       "name": "Color Cycle",
       "grid_options": {
        "columns": 12
       },
       "features": [
        {
         "type": "select-options"
        }
       ]
      }
     ]
    }
   ]
  }
 ]
}